+            initial={{ pathLength: 0, opacity: 0 }}
+            animate={inView ? { pathLength: 1, opacity: 1 } : {}}
+            transition={{ duration: 0.5, delay: 0.3 + i * 0.06 }}
+          />
+        ))}
+        {nodes.map((n, i) => (
+          <motion.circle
+            key={i}
+            cx={n.x * 2} cy={n.y * 1.2}
