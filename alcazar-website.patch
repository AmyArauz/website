+    { label: '', active: false, x: 65, y: 55 },
+    { label: '', active: false, x: 35, y: 55 },
+  ]
+
+  const edges = [
+    [0, 1], [0, 2], [1, 3], [2, 3], [1, 4], [2, 5], [4, 3], [5, 3],
+  ]
+
+  return (
+    <div ref={ref} style={{
