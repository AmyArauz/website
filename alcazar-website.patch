+++ b/alcazar-capital/app/globals.css
@@ -0,0 +1,54 @@
+@import "tailwindcss";
+
+:root {
+  --deep-blue: #113249;
+  --deep-blue-light: #1a4a6e;
+  --accent-blue: #6BA4F8;
+  --surface: #080808;
+  --surface-2: #0f0f0f;
+  --surface-3: #161616;
+}
+
+@theme inline {
+  --color-deep-blue: #113249;
+  --color-deep-blue-light: #1a4a6e;
+  --color-deep-blue-dark: #0b2233;
+  --color-accent-blue: #6BA4F8;
+  --color-surface: #080808;
+  --color-surface-2: #0f0f0f;
+  --color-surface-3: #161616;
+  --color-gray-dim: #888888;
+  --color-gray-muted: #444444;
+  --color-border: rgba(255,255,255,0.07);
+  --font-sans: 'IBM Plex Sans', sans-serif;
+  --font-serif: 'IBM Plex Serif', serif;
+}
+
+*, *::before, *::after {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+  background: #000;
+}
+
+body {
+  font-family: 'IBM Plex Sans', sans-serif;
+  font-weight: 300;
+  color: #fff;
+  background: #000;
+  line-height: 1.7;
+  overflow-x: hidden;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+::selection {
+  background: #113249;
+  color: #fff;
+}
+
+::-webkit-scrollbar { width: 3px; }
+::-webkit-scrollbar-track { background: #000; }
+::-webkit-scrollbar-thumb { background: #113249; border-radius: 2px; }
