+              fontSize: 'clamp(28px, 3vw, 44px)',
+              fontWeight: 300, color: '#fff',
+              lineHeight: 1.2, letterSpacing: '-0.01em', marginBottom: '24px',
+            }}>
+              Request Access
+            </h2>
+          </FadeIn>
+          <FadeIn delay={0.15}>
+            <p style={{ fontSize: '15px', color: 'rgba(255,255,255,0.4)', lineHeight: 1.85, marginBottom: '40px' }}>
+              Interested in learning more about Alcazar Capital Management? We welcome conversations
+              with qualified institutional investors, family offices, and strategic partners aligned
+              with our long-term vision.
+            </p>
+          </FadeIn>
+          <FadeIn delay={0.2}>
+            <div style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
+              {[
+                { dot: true, text: 'inquiries@alcazarcapital.com' },
+                { dot: true, text: 'New York · London · Singapore' },
+              ].map((item, i) => (
+                <div key={i} style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
+                  <span style={{ width: '5px', height: '5px', borderRadius: '50%', background: '#113249', flexShrink: 0 }} />
+                  <span style={{ fontSize: '14px', color: 'rgba(255,255,255,0.45)' }}>{item.text}</span>
