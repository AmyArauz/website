+        {edges.map(([a, b], i) => (
+          <motion.line
+            key={i}
+            x1={nodes[a].x * 2} y1={nodes[a].y * 1.2}
+            x2={nodes[b].x * 2} y2={nodes[b].y * 1.2}
+            stroke="rgba(107,164,248,0.2)"
