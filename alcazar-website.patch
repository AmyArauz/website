+        boxShadow: active ? '0 0 20px rgba(107,164,248,0.5)' : 'none',
+        transition: 'all 0.3s',
+        border: active ? '2px solid rgba(107,164,248,0.4)' : '1px solid rgba(107,164,248,0.2)',
